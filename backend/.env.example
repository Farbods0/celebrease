PORT=3000
APP_NAME=CeleBrease
API_PREFIX=api

# Frontend origins (comma-separated, no trailing slash)
CLIENT=http://localhost:4000,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/celebrease

# Better-Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:4000/checkout/success
STRIPE_CANCEL_URL=http://localhost:4000/checkout/cancel

# Email (optional)
MAIL_USER=
MAIL_PASS=

# Brevo newsletter (optional)
BREVO_API_KEY=
BREVO_LIST_ID=
