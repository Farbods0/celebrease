// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// AUTH (better-auth — do not rename fields/tables)
// ============================================================

model User {
    id            String    @id
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    role          String    @default("user")
    banned        Boolean   @default(false)
    phone         String?
    region        String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]

    stripeCustomerId String? @unique

    subscriptions Subscription[]

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

// ============================================================
// ENUMS
// ============================================================

enum HolidayCategory {
    TRADITIONAL
    CULTURAL
    EVENT_BASED
}

enum KitTier {
    STARTER
    PREMIUM
    ULTIMATE
}

enum KitStatus {
    DRAFT
    ACTIVE
    HIDDEN
    LOW_STOCK
}

enum ItemStatus {
    ACTIVE
    LOW_STOCK
    RETIRED
}

enum AddOnStatus {
    ACTIVE
    HIDDEN
}

enum PlanCode {
    STARTER
    PREMIUM
    ULTIMATE
}

enum BillingCycle {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    ACTIVE
    PAUSED
    CANCELLED
    EXPIRED
}

enum SubscriptionStage {
    NOT_STARTED
    IN_USE
    RETURNED
    COMPLETED
}

enum HolidaySlotStatus {
    PENDING
    SELECTED
    SHIPPED
    RETURNED
    SKIPPED
}

// ============================================================
// HOLIDAY
// ============================================================

model Holiday {
    id          String          @id @default(cuid())
    name        String
    image       String
    category    HolidayCategory
    description String?
    sortOrder   Int             @default(0)
    isActive    Boolean         @default(true)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    kits         Kit[]
    addOns       AddOnHoliday[]
    holidaySlots SubscriptionHolidaySlot[]

    @@map("holiday")
}

// ============================================================
// ITEMS
// ============================================================

model Item {
    id                String     @id @default(cuid())
    sku               String     @unique
    name              String
    image             String
    description       String?
    category          String? // Lighting, Tabletop Décor, Accents, Ornaments, etc.
    vendorName        String
    vendorEmail       String
    vendorPhone       String
    costPerUnit       Decimal    @db.Decimal(10, 2)
    totalQty          Int        @default(0)
    lowStockThreshold Int        @default(0)
    initialStatus     ItemStatus @default(ACTIVE)
    status            ItemStatus @default(ACTIVE)
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt

    kitItems        KitItem[]
    kitPreviewItems KitPreviewItem[]

    @@map("item")
}

// ============================================================
// KITS
// ============================================================

model Kit {
    id        String    @id @default(cuid())
    sku       String    @unique // e.g., XMAS-PREM-2025
    tier      KitTier
    holidayId String
    holiday   Holiday   @relation(fields: [holidayId], references: [id])
    status    KitStatus @default(DRAFT)

    price30Day Decimal @db.Decimal(10, 2)
    price60Day Decimal @db.Decimal(10, 2)
    deposit    Decimal @db.Decimal(10, 2)

    seasonStart DateTime?
    seasonEnd   DateTime?

    alwaysVisible  Boolean @default(false)
    visibleOnPdp   Boolean @default(true)
    addOnsEnabled  Boolean @default(true)
    limitInventory Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items        KitItem[]
    previewItems KitPreviewItem[]

    @@unique([holidayId, tier])
    @@index([holidayId])
    @@index([tier])
    @@map("kit")
}

model KitItem {
    id     String @id @default(cuid())
    kitId  String
    kit    Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId String
    item   Item   @relation(fields: [itemId], references: [id])
    qty    Int    @default(1)

    @@unique([kitId, itemId])
    @@index([itemId])
    @@map("kit_item")
}

model KitPreviewItem {
    id        String @id @default(cuid())
    kitId     String
    kit       Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId    String
    item      Item   @relation(fields: [itemId], references: [id])
    sortOrder Int    @default(0)

    @@unique([kitId, itemId])
    @@map("kit_preview_item")
}

// ============================================================
// ADD-ONS
// ============================================================

model AddOn {
    id          String      @id @default(cuid())
    sku         String?     @unique
    name        String
    image       String
    description String?
    price       Decimal     @db.Decimal(10, 2)
    deposit     Decimal     @default(0) @db.Decimal(10, 2)
    inventory   Int         @default(0)
    status      AddOnStatus @default(ACTIVE)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    holidays AddOnHoliday[]

    @@map("addon")
}

model AddOnHoliday {
    addOnId   String
    holidayId String
    addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
    holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

    @@id([addOnId, holidayId])
    @@map("addon_holiday")
}

// ============================================================
// PLANS + SUBSCRIPTIONS
// ============================================================

model Plan {
    id                   String   @id @default(cuid())
    code                 PlanCode @unique
    name                 String
    description          String?
    monthlyPrice         Decimal  @db.Decimal(10, 2)
    yearlyPrice          Decimal? @db.Decimal(10, 2)
    holidaysPerYear      Int      @default(3)
    isActive             Boolean  @default(true)
    sortOrder            Int      @default(0)
    stripePriceMonthlyId String?  @unique
    stripePriceYearlyId  String?  @unique
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    features      PlanFeature[]
    subscriptions Subscription[]

    @@map("plan")
}

model PlanFeature {
    id        String @id @default(cuid())
    planId    String
    plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
    text      String
    sortOrder Int    @default(0)

    @@index([planId])
    @@map("plan_feature")
}

model Subscription {
    id                   String             @id @default(cuid())
    userId               String
    user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    planId               String
    plan                 Plan               @relation(fields: [planId], references: [id])
    status               SubscriptionStatus @default(ACTIVE)
    stage                SubscriptionStage  @default(NOT_STARTED)
    billingCycle         BillingCycle       @default(MONTHLY)
    stripeSubscriptionId String?            @unique
    startedAt            DateTime           @default(now())
    cycleStart           DateTime?
    cycleEnd             DateTime?
    nextBillingAt        DateTime?
    cancelledAt          DateTime?
    createdAt            DateTime           @default(now())
    updatedAt            DateTime           @updatedAt

    holidaySlots SubscriptionHolidaySlot[]

    @@index([userId])
    @@index([status])
    @@map("subscription")
}

model SubscriptionHolidaySlot {
    id             String            @id @default(cuid())
    subscriptionId String
    subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    slotNumber     Int // 1, 2, 3
    holidayId      String?
    holiday        Holiday?          @relation(fields: [holidayId], references: [id])
    status         HolidaySlotStatus @default(PENDING)

    @@unique([subscriptionId, slotNumber])
    @@map("subscription_holiday_slot")
}
