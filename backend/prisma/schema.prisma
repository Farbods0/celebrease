// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// AUTH (better-auth — do not rename fields/tables)
// ============================================================

model User {
    id            String    @id
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    role          String    @default("user")
    banned        Boolean   @default(false)
    phone         String?
    region        String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]

    stripeCustomerId String? @unique

    addresses      Address[]
    paymentMethods PaymentMethod[]
    subscriptions  Subscription[]
    orders         Order[]
    returnsHandled Return[]        @relation("ReturnHandledBy")
    damageLogged   DamageEvent[]   @relation("DamageLoggedBy")
    cart           Cart?

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

// ============================================================
// ENUMS
// ============================================================

enum HolidayCategory {
    TRADITIONAL
    CULTURAL
    EVENT_BASED
}

enum KitTier {
    STARTER
    PREMIUM
    ULTIMATE
}

enum KitStatus {
    DRAFT
    ACTIVE
    HIDDEN
    LOW_STOCK
}

enum InventoryStatus {
    ACTIVE
    LOW_STOCK
    RETIRED
}

enum InventoryUnitStatus {
    AVAILABLE
    RESERVED
    SHIPPED
    IN_CLEANING
    IN_REPAIR
    RETIRED
    LOST
}

enum DamageEventType {
    BROKEN
    MISSING_PART
    LOST_BY_CUSTOMER
    DAMAGED_BY_CUSTOMER
    WORN_OUT
    OTHER
}

enum AddOnStatus {
    ACTIVE
    HIDDEN
}

enum PlanCode {
    STARTER
    PREMIUM
    ULTIMATE
}

enum BillingCycle {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    ACTIVE
    PAUSED
    CANCELLED
    EXPIRED
}

enum SubscriptionStage {
    NOT_STARTED
    IN_USE
    RETURNED
    COMPLETED
}

enum HolidaySlotStatus {
    PENDING
    SELECTED
    SHIPPED
    RETURNED
    SKIPPED
}

enum RentalDuration {
    THIRTY_DAY
    SIXTY_DAY
}

enum OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    RETURN_REQUESTED
    RETURNED
    CANCELLED
}

enum DepositStatus {
    PENDING
    HELD
    PARTIALLY_REFUNDED
    REFUNDED
    FORFEITED
}

enum DeliveryOption {
    STANDARD
    EXPRESS
}

enum AddressType {
    SHIPPING
    BILLING
}

enum PaymentMethodType {
    CARD
}

enum ReturnCondition {
    EXCELLENT
    MINOR_SCUFFS
    MAJOR_DAMAGE
}

enum RefundDecision {
    NO_REFUND
    PARTIAL_REFUND
    FULL_REFUND
}

// ============================================================
// USER PROFILE — addresses, payment methods
// ============================================================

model Address {
    id           String      @id @default(cuid())
    userId       String
    user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    type         AddressType @default(SHIPPING)
    name         String
    phone        String?
    streetLine1  String
    streetLine2  String?
    city         String
    state        String?
    postalCode   String
    country      String
    isDefault    Boolean     @default(false)
    deliveryNote String?
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    shippedOrders  Order[] @relation("OrderShippingAddress")
    billingOnOrder Order[] @relation("OrderBillingAddress")

    @@index([userId])
    @@map("address")
}

model PaymentMethod {
    id          String            @id @default(cuid())
    userId      String
    user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    type        PaymentMethodType @default(CARD)
    provider    String? // stripe, etc.
    providerRef String? // tokenized PM id
    brand       String? // visa, mastercard
    last4       String?
    expMonth    Int?
    expYear     Int?
    holderName  String?
    isDefault   Boolean           @default(false)
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    subscriptions Subscription[]
    orders        Order[]

    @@index([userId])
    @@map("payment_method")
}

// ============================================================
// TAXONOMY — holidays
// ============================================================

model Holiday {
    id          String          @id @default(cuid())
    name        String
    category    HolidayCategory
    description String?
    sortOrder   Int             @default(0)
    isActive    Boolean         @default(true)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    kits         Kit[]
    addOns       AddOnHoliday[]
    holidaySlots SubscriptionHolidaySlot[]
    orders       Order[]
    cartItems    CartItem[]

    @@map("holiday")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryItem {
    id                String          @id @default(cuid())
    sku               String          @unique
    name              String
    image             String
    description       String?
    category          String? // Lighting, Tabletop Décor, Accents, Ornaments, etc.
    vendorName        String
    vendorEmail       String
    vendorPhone       String
    costPerUnit       Decimal         @db.Decimal(10, 2)
    totalQty          Int             @default(0)
    lowStockThreshold Int             @default(0)
    initialStatus     InventoryStatus @default(ACTIVE)
    status            InventoryStatus @default(ACTIVE)
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt

    units           InventoryUnit[]
    kitItems        KitItem[]
    kitPreviewItems KitPreviewItem[]
    orderItems      OrderItem[]
    damageEvents    DamageEvent[]

    @@map("inventory_item")
}

// Optional per-physical-unit tracking. Aggregate counts by status are derivable
// from this table; UI lists like "Available 64 / Reserved 22 / Cleaning 14".
model InventoryUnit {
    id                 String              @id @default(cuid())
    itemId             String
    item               InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
    serialNumber       String?             @unique
    status             InventoryUnitStatus @default(AVAILABLE)
    currentOrderItemId String?
    currentOrderItem   OrderItem?          @relation(fields: [currentOrderItemId], references: [id])
    notes              String?
    retiredAt          DateTime?
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt

    damageEvents DamageEvent[]

    @@index([itemId, status])
    @@map("inventory_unit")
}

model DamageEvent {
    id          String          @id @default(cuid())
    itemId      String
    item        InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
    unitId      String?
    unit        InventoryUnit?  @relation(fields: [unitId], references: [id])
    type        DamageEventType
    description String
    occurredAt  DateTime        @default(now())
    loggedById  String?
    loggedBy    User?           @relation("DamageLoggedBy", fields: [loggedById], references: [id])
    returnId    String?
    return      Return?         @relation(fields: [returnId], references: [id])

    @@index([itemId])
    @@index([unitId])
    @@map("damage_event")
}

// ============================================================
// KITS + BILL-OF-MATERIALS
// ============================================================

model Kit {
    id          String    @id @default(cuid())
    sku         String    @unique // e.g., XMAS-PREM-2025
    name        String
    description String?
    tier        KitTier
    holidayId   String
    holiday     Holiday   @relation(fields: [holidayId], references: [id])
    status      KitStatus @default(DRAFT)

    price30Day Decimal  @db.Decimal(10, 2)
    price60Day Decimal? @db.Decimal(10, 2)
    deposit    Decimal  @db.Decimal(10, 2)

    seasonStart DateTime?
    seasonEnd   DateTime?

    alwaysVisible  Boolean @default(false)
    visibleOnPdp   Boolean @default(true)
    addOnsEnabled  Boolean @default(true)
    limitInventory Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items         KitItem[]
    images        KitImage[]
    previewItems  KitPreviewItem[]
    allowedAddOns KitAddOn[]
    orders        Order[]
    cartItems     CartItem[]

    @@index([holidayId])
    @@index([tier])
    @@map("kit")
}

model KitImage {
    id        String   @id @default(cuid())
    kitId     String
    kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
    url       String
    sortOrder Int      @default(0)
    createdAt DateTime @default(now())

    @@index([kitId])
    @@map("kit_image")
}

// Bill of materials — what physical items make up the kit, and how many.
model KitItem {
    id     String        @id @default(cuid())
    kitId  String
    kit    Kit           @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId String
    item   InventoryItem @relation(fields: [itemId], references: [id])
    qty    Int           @default(1)

    @@unique([kitId, itemId])
    @@index([itemId])
    @@map("kit_item")
}

// Subset of items shown on the customer-facing PDP preview.
model KitPreviewItem {
    id        String        @id @default(cuid())
    kitId     String
    kit       Kit           @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId    String
    item      InventoryItem @relation(fields: [itemId], references: [id])
    sortOrder Int           @default(0)

    @@unique([kitId, itemId])
    @@map("kit_preview_item")
}

// ============================================================
// ADD-ONS
// ============================================================

model AddOn {
    id          String      @id @default(cuid())
    sku         String?     @unique
    name        String
    description String?
    price       Decimal     @db.Decimal(10, 2)
    deposit     Decimal     @default(0) @db.Decimal(10, 2)
    inventory   Int         @default(0)
    status      AddOnStatus @default(ACTIVE)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    images         AddOnImage[]
    holidays       AddOnHoliday[]
    kitLinks       KitAddOn[]
    orderAddOns    OrderAddOn[]
    cartItemAddOns CartItemAddOn[]

    @@map("addon")
}

model AddOnImage {
    id        String @id @default(cuid())
    addOnId   String
    addOn     AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
    url       String
    sortOrder Int    @default(0)

    @@index([addOnId])
    @@map("addon_image")
}

model AddOnHoliday {
    addOnId   String
    holidayId String
    addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
    holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

    @@id([addOnId, holidayId])
    @@map("addon_holiday")
}

// Which add-ons are offered for which kit (admin curates per kit).
model KitAddOn {
    kitId   String
    addOnId String
    kit     Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
    addOn   AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)

    @@id([kitId, addOnId])
    @@map("kit_addon")
}

// ============================================================
// PLANS + SUBSCRIPTIONS
// ============================================================

model Plan {
    id                   String   @id @default(cuid())
    code                 PlanCode @unique
    name                 String
    description          String?
    monthlyPrice         Decimal  @db.Decimal(10, 2)
    yearlyPrice          Decimal? @db.Decimal(10, 2)
    holidaysPerYear      Int      @default(3)
    isActive             Boolean  @default(true)
    sortOrder            Int      @default(0)
    stripePriceMonthlyId String?  @unique
    stripePriceYearlyId  String?  @unique
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    features      PlanFeature[]
    subscriptions Subscription[]

    @@map("plan")
}

model PlanFeature {
    id        String @id @default(cuid())
    planId    String
    plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
    text      String
    sortOrder Int    @default(0)

    @@index([planId])
    @@map("plan_feature")
}

model Subscription {
    id                   String             @id @default(cuid())
    userId               String
    user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    planId               String
    plan                 Plan               @relation(fields: [planId], references: [id])
    status               SubscriptionStatus @default(ACTIVE)
    stage                SubscriptionStage  @default(NOT_STARTED)
    billingCycle         BillingCycle       @default(MONTHLY)
    paymentMethodId      String?
    paymentMethod        PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
    stripeSubscriptionId String?            @unique
    startedAt            DateTime           @default(now())
    cycleStart           DateTime?
    cycleEnd             DateTime?
    nextBillingAt        DateTime?
    cancelledAt          DateTime?
    createdAt            DateTime           @default(now())
    updatedAt            DateTime           @updatedAt

    holidaySlots SubscriptionHolidaySlot[]
    orders       Order[]

    @@index([userId])
    @@index([status])
    @@map("subscription")
}

// 3 (or N, based on plan.holidaysPerYear) holiday slots per cycle.
model SubscriptionHolidaySlot {
    id             String            @id @default(cuid())
    subscriptionId String
    subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    slotNumber     Int // 1, 2, 3
    holidayId      String?
    holiday        Holiday?          @relation(fields: [holidayId], references: [id])
    status         HolidaySlotStatus @default(PENDING)
    orderId        String?           @unique
    order          Order?            @relation(fields: [orderId], references: [id])

    @@unique([subscriptionId, slotNumber])
    @@map("subscription_holiday_slot")
}

// ============================================================
// CART
// ============================================================

model Cart {
    id        String   @id @default(cuid())
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items CartItem[]

    @@map("cart")
}

model CartItem {
    id        String          @id @default(cuid())
    cartId    String
    cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
    kitId     String
    kit       Kit             @relation(fields: [kitId], references: [id])
    holidayId String
    holiday   Holiday         @relation(fields: [holidayId], references: [id])
    duration  RentalDuration  @default(THIRTY_DAY)
    startDate DateTime
    endDate   DateTime
    addOns    CartItemAddOn[]
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@index([cartId])
    @@map("cart_item")
}

model CartItemAddOn {
    id         String   @id @default(cuid())
    cartItemId String
    cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
    addOnId    String
    addOn      AddOn    @relation(fields: [addOnId], references: [id])
    qty        Int      @default(1)

    @@unique([cartItemId, addOnId])
    @@map("cart_item_addon")
}

// Reverse relations not yet declared on Kit/Holiday/AddOn — declared above where needed.

// ============================================================
// ORDERS (rentals)
// ============================================================

model Order {
    id             String        @id @default(cuid())
    orderNumber    String        @unique // human-readable e.g., ORD-00012
    userId         String
    user           User          @relation(fields: [userId], references: [id])
    subscriptionId String?
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

    kitId     String
    kit       Kit            @relation(fields: [kitId], references: [id])
    holidayId String
    holiday   Holiday        @relation(fields: [holidayId], references: [id])
    duration  RentalDuration @default(THIRTY_DAY)

    status OrderStatus @default(PENDING)

    shippingAddressId String?
    shippingAddress   Address?       @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
    billingAddressId  String?
    billingAddress    Address?       @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
    paymentMethodId   String?
    paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

    deliveryOption DeliveryOption @default(STANDARD)
    deliveryNote   String?

    rentalPrice   Decimal       @db.Decimal(10, 2)
    addOnsTotal   Decimal       @default(0) @db.Decimal(10, 2)
    deliveryFee   Decimal       @default(0) @db.Decimal(10, 2)
    taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
    totalAmount   Decimal       @db.Decimal(10, 2)
    depositAmount Decimal       @db.Decimal(10, 2)
    depositStatus DepositStatus @default(PENDING)
    depositRefund Decimal       @default(0) @db.Decimal(10, 2)

    rentalStart      DateTime
    rentalEnd        DateTime
    shippedAt        DateTime?
    deliveredAt      DateTime?
    expectedReturnAt DateTime?
    returnedAt       DateTime?
    cancelledAt      DateTime?

    trackingNumber  String?
    trackingCarrier String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    addOns      OrderAddOn[]
    items       OrderItem[]
    return      Return?
    holidaySlot SubscriptionHolidaySlot?

    @@index([userId])
    @@index([subscriptionId])
    @@index([kitId])
    @@index([status])
    @@map("order")
}

// Snapshot of the kit BOM at the time of order — lets each line item be tied
// to a specific InventoryUnit so admins can see who has what.
model OrderItem {
    id              String        @id @default(cuid())
    orderId         String
    order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
    inventoryItemId String
    inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
    qty             Int           @default(1)

    units InventoryUnit[]

    @@index([orderId])
    @@map("order_item")
}

model OrderAddOn {
    id        String  @id @default(cuid())
    orderId   String
    order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    addOnId   String
    addOn     AddOn   @relation(fields: [addOnId], references: [id])
    qty       Int     @default(1)
    unitPrice Decimal @db.Decimal(10, 2)
    deposit   Decimal @default(0) @db.Decimal(10, 2)

    @@index([orderId])
    @@map("order_addon")
}

// Cross-reference back-ref needed because of CartItem -> InventoryItem (KitItem); already in InventoryItem via kitItems

// Need back-ref on InventoryItem for OrderItem (added implicitly above)

// ============================================================
// RETURNS + INSPECTION
// ============================================================

model Return {
    id             String           @id @default(cuid())
    returnNumber   String           @unique // RET-00012
    orderId        String           @unique
    order          Order            @relation(fields: [orderId], references: [id])
    dueDate        DateTime?
    receivedAt     DateTime?
    inspectedAt    DateTime?
    inspectedById  String?
    inspectedBy    User?            @relation("ReturnHandledBy", fields: [inspectedById], references: [id])
    condition      ReturnCondition?
    damageNotes    String?
    refundDecision RefundDecision   @default(NO_REFUND)
    refundAmount   Decimal          @default(0) @db.Decimal(10, 2)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    damageImages ReturnDamageImage[]
    damageEvents DamageEvent[]

    @@map("return")
}

model ReturnDamageImage {
    id       String  @id @default(cuid())
    returnId String
    return   Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
    url      String
    caption  String?

    @@index([returnId])
    @@map("return_damage_image")
}
