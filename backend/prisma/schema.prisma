// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// AUTH (better-auth — do not rename fields/tables)
// ============================================================

model User {
    id            String    @id
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    role          String    @default("user")
    banned        Boolean   @default(false)
    phone         String?
    region        String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]

    stripeCustomerId String? @unique

    address       Address?
    subscriptions Subscription[]
    holidayLoves  HolidayLove[]
    carts         Cart[]
    orders        Order[]

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
    id          String   @id @default(cuid())
    userId      String   @unique
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    phone       String
    streetLine1 String
    streetLine2 String?
    city        String
    state       String
    postalCode  String
    country     String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([userId])
    @@map("address")
}

// ============================================================
// ENUMS
// ============================================================

enum HolidayCategory {
    TRADITIONAL
    CULTURAL
    EVENT_BASED
}

enum KitTier {
    STARTER
    PREMIUM
    ULTIMATE
}

enum KitStatus {
    DRAFT
    ACTIVE
    HIDDEN
    LOW_STOCK
}

enum ItemStatus {
    ACTIVE
    HIDDEN
    LOW_STOCK
}

enum PlanCode {
    STARTER
    PREMIUM
    ULTIMATE
}

enum BillingCycle {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    ACTIVE
    PAUSED
    CANCELLED
    EXPIRED
}

enum SubscriptionStage {
    NOT_STARTED
    IN_USE
    RETURNED
    COMPLETED
}

enum HolidaySlotStatus {
    PENDING
    SELECTED
    SHIPPED
    RETURNED
    SKIPPED
}

// ============================================================
// HOLIDAY
// ============================================================

model Holiday {
    id          String          @id @default(cuid())
    name        String
    image       String
    category    HolidayCategory
    description String?
    sortOrder   Int             @default(0)
    isActive    Boolean         @default(true)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    kits         Kit[]
    addOns       AddOnHoliday[]
    holidaySlots SubscriptionHolidaySlot[]
    loves        HolidayLove[]
    carts        Cart[]
    orders       Order[]

    @@map("holiday")
}

model HolidayLove {
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    holidayId String
    holiday   Holiday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([userId, holidayId])
    @@index([holidayId])
    @@map("holiday_love")
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
    id String @id @default(cuid())

    // The exact physical counts
    totalQty     Int @default(0) // Total owned
    availableQty Int @default(0) // Ready in warehouse
    reservedQty  Int @default(0) // Allocated to a pending/paid order
    shippedQty   Int @default(0) // Out with a customer
    cleaningQty  Int @default(0) // Returned, needs cleaning
    repairQty    Int @default(0) // Returned, needs repair
    lostQty      Int @default(0) // Permanently lost/damaged

    // Relation to Item (Optional)
    itemId String? @unique
    item   Item?   @relation(fields: [itemId], references: [id], onDelete: Cascade)

    // Relation to AddOn (Optional)
    addOnId String? @unique
    addOn   AddOn?  @relation(fields: [addOnId], references: [id], onDelete: Cascade)

    updatedAt DateTime @updatedAt

    @@map("inventory")
}

// ============================================================
// ITEMS
// ============================================================

model Item {
    id                String     @id @default(cuid())
    sku               String     @unique
    name              String
    image             String
    description       String?
    category          String? // Lighting, Tabletop Décor, Accents, Ornaments, etc.
    vendorName        String
    vendorEmail       String
    vendorPhone       String
    costPerUnit       Decimal    @db.Decimal(10, 2)
    lowStockThreshold Int        @default(0)
    status            ItemStatus @default(ACTIVE)
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt

    kitItems        KitItem[]
    kitPreviewItems KitPreviewItem[]
    inventory       Inventory?
    cartItems       CartItem[]
    orderItems      OrderItem[]

    @@map("item")
}

// ============================================================
// KITS
// ============================================================

model Kit {
    id        String    @id @default(cuid())
    sku       String    @unique // e.g., XMAS-PREM-2025
    tier      KitTier
    holidayId String
    holiday   Holiday   @relation(fields: [holidayId], references: [id])
    status    KitStatus @default(DRAFT)

    price30Day Decimal @db.Decimal(10, 2)
    price60Day Decimal @db.Decimal(10, 2)
    deposit    Decimal @db.Decimal(10, 2)

    seasonStart DateTime?
    seasonEnd   DateTime?

    alwaysVisible  Boolean @default(false)
    visibleOnPdp   Boolean @default(true)
    addOnsEnabled  Boolean @default(true)
    limitInventory Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    items        KitItem[]
    previewItems KitPreviewItem[]
    carts        Cart[]
    orders       Order[]

    @@unique([holidayId, tier])
    @@index([holidayId])
    @@index([tier])
    @@map("kit")
}

model KitItem {
    kitId  String
    kit    Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId String
    item   Item   @relation(fields: [itemId], references: [id])
    qty    Int    @default(1)

    @@unique([kitId, itemId])
    @@index([itemId])
    @@map("kit_item")
}

model KitPreviewItem {
    kitId     String
    kit       Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
    itemId    String
    item      Item   @relation(fields: [itemId], references: [id])
    sortOrder Int    @default(0)

    @@unique([kitId, itemId])
    @@map("kit_preview_item")
}

// ============================================================
// ADD-ONS
// ============================================================

model AddOn {
    id          String   @id @default(cuid())
    sku         String?  @unique
    name        String
    image       String
    description String?
    price       Decimal  @db.Decimal(10, 2)
    deposit     Decimal  @default(0) @db.Decimal(10, 2)
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    holidays    AddOnHoliday[]
    inventory   Inventory?
    cartAddOns  CartAddOn[]
    orderAddOns OrderAddOn[]

    @@map("addon")
}

model AddOnHoliday {
    addOnId   String
    holidayId String
    addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
    holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

    @@id([addOnId, holidayId])
    @@map("addon_holiday")
}

// ============================================================
// PLANS + SUBSCRIPTIONS
// ============================================================

model Plan {
    id                   String   @id @default(cuid())
    code                 PlanCode @unique
    name                 String
    description          String?
    monthlyPrice         Decimal  @db.Decimal(10, 2)
    yearlyPrice          Decimal? @db.Decimal(10, 2)
    holidaysPerYear      Int      @default(3)
    kitDiscount          Int      @default(0)
    addOnDiscount        Int      @default(0)
    isActive             Boolean  @default(true)
    sortOrder            Int      @default(0)
    stripePriceMonthlyId String?  @unique
    stripePriceYearlyId  String?  @unique
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    features      PlanFeature[]
    subscriptions Subscription[]

    @@map("plan")
}

model PlanFeature {
    id        String @id @default(cuid())
    planId    String
    plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
    text      String
    sortOrder Int    @default(0)

    @@index([planId])
    @@map("plan_feature")
}

model Subscription {
    id                   String             @id @default(cuid())
    userId               String
    user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    planId               String
    plan                 Plan               @relation(fields: [planId], references: [id])
    status               SubscriptionStatus @default(ACTIVE)
    stage                SubscriptionStage  @default(NOT_STARTED)
    billingCycle         BillingCycle       @default(MONTHLY)
    stripeSubscriptionId String?            @unique
    startedAt            DateTime           @default(now())
    cycleStart           DateTime?
    cycleEnd             DateTime?
    nextBillingAt        DateTime?
    cancelledAt          DateTime?
    createdAt            DateTime           @default(now())
    updatedAt            DateTime           @updatedAt

    holidaySlots SubscriptionHolidaySlot[]
    orders       Order[]

    @@index([userId])
    @@index([status])
    @@map("subscription")
}

model SubscriptionHolidaySlot {
    id             String            @id @default(cuid())
    subscriptionId String
    subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    slotNumber     Int // 1, 2, 3
    holidayId      String?
    holiday        Holiday?          @relation(fields: [holidayId], references: [id])
    status         HolidaySlotStatus @default(PENDING)
    order          Order?

    @@unique([subscriptionId, slotNumber])
    @@map("subscription_holiday_slot")
}

// ============================================================
// CART
// ============================================================

enum Duration {
    THIRTY_DAY
    SIXTY_DAY
}

model Cart {
    id           String   @id @default(cuid())
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    kitId        String
    kit          Kit      @relation(fields: [kitId], references: [id])
    holidayId    String
    holiday      Holiday  @relation(fields: [holidayId], references: [id])
    duration     Duration @default(THIRTY_DAY)
    startDate    DateTime
    endDate      DateTime
    rentalFee    Decimal  @db.Decimal(10, 2) // Rental Fee
    extendedFee  Decimal  @db.Decimal(10, 2) // Extended Fee if 60 days
    kitDeposit   Decimal  @db.Decimal(10, 2) // Kit Deposit (Refundable)
    addOnsFee    Decimal  @db.Decimal(10, 2) // Add-ons Fee
    addOnDeposit Decimal  @db.Decimal(10, 2) // Add-ons Deposit (Refundable)
    total        Decimal  @db.Decimal(10, 2) // Total
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    items  CartItem[]
    addOns CartAddOn[]

    @@map("cart")
}

model CartItem {
    cartId String
    cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
    itemId String
    item   Item   @relation(fields: [itemId], references: [id])
    qty    Int    @default(1)

    @@unique([cartId, itemId])
    @@map("cart_item")
}

model CartAddOn {
    cartId  String
    cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
    addOnId String
    addOn   AddOn   @relation(fields: [addOnId], references: [id])
    qty     Int     @default(1)
    price   Decimal @db.Decimal(10, 2)
    deposit Decimal @db.Decimal(10, 2)

    @@unique([cartId, addOnId])
    @@map("cart_addon")
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
    PENDING
    SHIPPED
    DELIVERED
    RESERVED
    CANCELLED
    COMPLETED
    RETURN_REQUESTED
    RETURN_IN_TRANSIT
    RETURN_RECEIVED
    INSPECTED
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
}

enum ReturnCondition {
    GOOD
    DAMAGED
    MISSING
    LOST
}

model Order {
    id             String                   @id @default(cuid())
    orderNumber    String                   @unique // Human-readable: ORD-20260506-XXXX
    userId         String
    user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
    subscriptionId String?
    subscription   Subscription?            @relation(fields: [subscriptionId], references: [id])
    holidaySlotId  String?                  @unique
    holidaySlot    SubscriptionHolidaySlot? @relation(fields: [holidaySlotId], references: [id])
    kitId          String
    kit            Kit                      @relation(fields: [kitId], references: [id])
    holidayId      String
    holiday        Holiday                  @relation(fields: [holidayId], references: [id])

    duration  Duration @default(THIRTY_DAY)
    startDate DateTime
    endDate   DateTime

    // Pricing
    rentalFee     Decimal @db.Decimal(10, 2)
    extendedFee   Decimal @db.Decimal(10, 2)
    kitDeposit    Decimal @db.Decimal(10, 2)
    addOnsFee     Decimal @db.Decimal(10, 2)
    addOnDeposit  Decimal @db.Decimal(10, 2)
    kitDiscount   Decimal @db.Decimal(10, 2)
    addOnDiscount Decimal @db.Decimal(10, 2)
    total         Decimal @db.Decimal(10, 2)
    tax           Decimal @db.Decimal(10, 2)
    shippingFee   Decimal @db.Decimal(10, 2)

    // Status
    status        OrderStatus   @default(PENDING)
    paymentStatus PaymentStatus @default(PENDING)

    // Payment
    paidAt                DateTime?
    stripePaymentIntentId String?   @unique
    stripeChargeId        String?

    // Tracking
    trackingNumber String?
    trackingUrl    String?

    // Return
    returnLabelUrl       String?
    returnTrackingNumber String?
    returnTrackingUrl    String?
    returnRequestedAt    DateTime?
    returnShippedAt      DateTime?
    returnReceivedAt     DateTime?
    inspectedAt          DateTime?
    inspectionNotes      String?
    depositRefunded      Decimal   @default(0) @db.Decimal(10, 2)
    depositForfeited     Decimal   @default(0) @db.Decimal(10, 2)
    stripeRefundId       String?

    // Timestamps
    shippedAt   DateTime?
    deliveredAt DateTime?
    cancelledAt DateTime?
    completedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    items       OrderItem[]
    addOns      OrderAddOn[]
    returnLines OrderReturnLine[]

    @@index([userId])
    @@index([status])
    @@index([orderNumber])
    @@map("order")
}

model OrderItem {
    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
    itemId  String
    item    Item   @relation(fields: [itemId], references: [id])
    qty     Int    @default(1)

    @@unique([orderId, itemId])
    @@map("order_item")
}

model OrderAddOn {
    orderId String
    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    addOnId String
    addOn   AddOn   @relation(fields: [addOnId], references: [id])
    qty     Int     @default(1)
    price   Decimal @db.Decimal(10, 2)
    deposit Decimal @db.Decimal(10, 2)

    @@unique([orderId, addOnId])
    @@map("order_addon")
}

// ============================================================
// RETURNS
// ============================================================

model OrderReturnLine {
    id        String          @id @default(cuid())
    orderId   String
    order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
    itemId    String?
    addOnId   String?
    qty       Int             @default(1)
    condition ReturnCondition
    feeCharged Decimal        @default(0) @db.Decimal(10, 2)
    notes     String?
    createdAt DateTime        @default(now())

    @@index([orderId])
    @@map("order_return_line")
}
